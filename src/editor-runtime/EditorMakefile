TARGET = build/ucg_editor
OBJS = build/editor_main.o build/storage_hooks.o
CFLAGS = -O2 -G0 -Wall -Wextra -Werror -ffunction-sections -fdata-sections
CXXFLAGS = -std=gnu++17 -fno-exceptions -fno-rtti -DUCG_EDITOR_MODULE $(EDITOR_TEST)
LDFLAGS += -Wl,--gc-sections -Wl,--wrap=fopen -Wl,--wrap=rename -Wl,--wrap=unlink -Wl,--wrap=remove -Wl,--wrap=stat
LIBS = -lpspsystemctrl_user -lpsppower -lpsprtc -lpspgu -lpspaudio -lpsputility -lpng -ljpeg -lz -lvorbisfile -lvorbis -logg -lstdc++ -lm
BUILD_PRX = 1
PSP_FW_VERSION = 660
PSP_LARGE_MEMORY = 0
EXTRA_TARGETS = $(PSP_EBOOT)
PSP_EBOOT_TITLE = Uncanny Cat Golf - Level Editor
PSP_EBOOT_SFO = build/EDITOR-SFO
PSP_EBOOT = build/EDITOR.PBP
PSPSDK := $(shell psp-config --pspsdk-path)
include $(PSPSDK)/lib/build.mak
build/storage_hooks.o: storage_hooks.cpp storage_hooks.hpp storage_reader.hpp storage_pool.hpp storage_stdio.hpp storage_diagnostic.hpp storage_file_pool.hpp
	$(CXX) $(CXXFLAGS) -c $< -o $@
build/editor_main.o: editor_main.cpp $(wildcard *.hpp)
	$(CXX) $(CXXFLAGS) -c $< -o $@

