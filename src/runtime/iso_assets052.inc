inline std::string isoAssetPath(std::string_view logical) {
    using namespace IsoAssets041;
    const auto end=std::end(entries);
    const auto found=std::lower_bound(std::begin(entries),end,logical,
        [](const Entry& entry,std::string_view name) { return entry.logical<name; });
    if (found==end || found->logical!=logical) return {};
    return std::string("disc0:/PSP_GAME/USRDIR/")+found->physical;
}
